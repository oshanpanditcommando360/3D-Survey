generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ScanStatus {
  queued
  processing
  complete
  failed
}

model Scan {
  id             String     @id @default(cuid())
  status         ScanStatus @default(queued)
  progress       Int        @default(10)
  frameCount     Int        @default(0)
  coverage       Int        @default(0)
  captureMode    String     @default("continuous-survey")
  locationStatus String     @default("unknown")
  latitude       Float?
  longitude      Float?
  altitude       Float?
  accuracy       Float?
  frames         Json
  coverageMap    Json?
  summary        Json?
  model          Json?
  createdAt      DateTime   @default(now())
  completedAt    DateTime?
  updatedAt      DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}
